# Copy to .env.local and fill in. Never commit .env.local.
# Local values: run `npx supabase status` after `npm run db:start`.

# Supabase (hosted project must be in EU / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend, verified domain with SPF/DKIM)
RESEND_API_KEY=
EMAIL_FROM="Медицински център <prevention@yourdomain.bg>"

# Cloudflare Turnstile. Local development: Cloudflare test keys (always pass)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production: real widget keys (test secret is refused on Vercel production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key for hashing client IPs in the rate limiter (min 32 chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Protects /api/cron/* endpoints
CRON_SECRET=

# Public base URL, e.g. https://zapis.yourdomain.bg (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# GDPR: bookings older than this are anonymized
DATA_RETENTION_MONTHS=12
